NEXT_PUBLIC_VERSION=5.2.0
NEXT_PUBLIC_ENVIRONMENT=production

NEXT_PUBLIC_API_URL="https://app.flozaa.com/api/v1/"
NEXT_PUBLIC_SITE_URL="https://app.flozaa.com"

# true  = dynamic/VPS deploy — pages fetch server-side (SEO-friendly SSR)
# false = static export/shared hosting — pages skip server fetch, load client-side only
NEXT_PUBLIC_SEO=true

# Used only when admin's settings.map_provider === "google". OSM/Leaflet needs no key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyADhehoWvCdP7f_4oh1g79aP7eIPcZI0FY"

# Cosmetic default map pin position (e.g. your city's center) — shown before
# geolocation resolves or the user searches/drags/picks a spot. Never sent to
# any API, never saved as a real location. Set these to your own service
# area; defaults to Bhuj, India if unset.
NEXT_PUBLIC_DEFAULT_MAP_LAT=6.9271
NEXT_PUBLIC_DEFAULT_MAP_LNG=79.8612

# Phone input fallbacks, used only when admin's general_settings.default_country_code /
# available_country_codes are empty or not yet loaded. NEXT_PUBLIC_DEFAULT_COUNTRY_CODES
# is a comma-separated list of ISO codes (e.g. "in,us,gb").
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=lk
NEXT_PUBLIC_DEFAULT_COUNTRY_CODES=lk,us

# Firebase — phone OTP auth, Google sign-in, FCM push
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyADhehoWvCdP7f_4oh1g79aP7eIPcZI0FY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=flozaa-b5c77.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fflozaa-b5c77
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=flozaa-b5c77.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGEING_SENDER_ID=107159544718
NEXT_PUBLIC_FIREBASE_APP_ID=1:107159544718:web:369d5b065f358790b0fadf
NEXT_PUBLIC_FIREBASE_MESUMENT_ID=G-F11RRXCVGE
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BJLGFmTIRPSh2fU2107Prtw9cQlXK5A5QtyOaMXMXyZv5gR4ANe22ZQGpFZBrWy3U1_at13Kch53WpQhllNz09I

# GA4 measurement + Microsoft Clarity project id — loaded only after analytics
# consent is granted (see src/components/layout/consent-scripts.tsx). Same
# GA4 property and Clarity project as the eDemandNextJs app (same product).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-WE9JH9V729
NEXT_PUBLIC_CLARITY_PROJECT_ID=z1t5y613rd
# Google AdSense publisher id — loaded unconditionally in pages/_document.tsx.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx


